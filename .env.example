# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── Session ───────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=

# ── Google Places API ─────────────────────────────────────────────────────────
# Used for live lodging and restaurant lookups on the Places tab
# Enable at: https://console.cloud.google.com → APIs & Services → Places API
GOOGLE_PLACES_KEY=

# ── Admin ─────────────────────────────────────────────────────────────────────
# Protects /api/admin/* endpoints
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite — file path relative to project root (default: data.db)
# Override only if deploying to a volume-mounted path
# DATABASE_URL=./data.db

# ── iOS / StoreKit 2 ─────────────────────────────────────────────────────────
# No server-side Stripe keys needed — payments handled natively via StoreKit 2
# Product IDs are configured in App Store Connect:
#   com.flydentify.monthly   $6.99/month — 7-day free trial
#   com.flydentify.annual    $39.99/year — 7-day free trial

# ── Optional integrations ─────────────────────────────────────────────────────
# NOAA and USGS APIs are open — no keys required
# iNaturalist API is open — no keys required
